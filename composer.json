{
    "name": "maartendeblock/yuki-api-client",
    "description": "Modern PHP client for the Yuki API with fluent interface, automatic session management, and comprehensive error handling",
    "version": "2.0.0",
    "type": "library",
    "license": "MIT",
    "keywords": ["yuki", "api", "client", "fluent", "soap"],
    "autoload": {
        "psr-4": {
            "MaartenDeBlock\\YukiApiClient\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Maarten De Block",
            "email": "info@maartendeblock.be"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "require": {
        "php": "^8.1",
        "phpro/soap-client": "^3.3",
        "symfony/http-client": "^6.4",
        "nyholm/psr7": "^1.8",
        "php-soap/wsdl-reader": "^0.16.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.0-dev"
        }
    }
}